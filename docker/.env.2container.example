# PantryButler — 2-Container Standalone Environment
#
# This is the COMMITTED TEMPLATE. Copy it to docker/.env.2container (gitignored)
# or let a startup script create it:
#   cp docker/.env.2container.example docker/.env.2container
#   ./start-mac.sh
# Or set these variables in your shell environment.

# PostgreSQL
POSTGRES_USER=pantrybutler
POSTGRES_PASSWORD=pb_local_9f2c4a7e_5b8d
POSTGRES_DB=pantrybutler

# JWT — generate a strong 64-character random string:
#   openssl rand -hex 32
#   pwgen -s 64 1
# This is the PLACEHOLDER. Every startup script (start-standalone.sh,
# start-mac.sh, start-windows.ps1) auto-rotates it to a random secret when it
# is still the placeholder (or any leaked committed value), and the server
# REFUSES to boot with a known secret. Never commit a real secret.
JWT_SECRET=generate-a-random-64-char-string

# Admin pages (Admin Instances, Admin Announcements). Set to true to enable;
# they are only accessible by the system superadmin when enabled.
# On by default: scripts/smoke-test.py uses the admin instance-delete API to
# leave no data behind.
ENABLE_ADMIN_FEATURES=true

# Email verification (used when ENABLE_ADMIN_FEATURES=true).
# REQUIRE_EMAIL_VERIFICATION defaults to true when admin features are on;
# set false to allow creators to sign in without confirming their email.
#REQUIRE_EMAIL_VERIFICATION=true

# Public base URL for links in verification/notification emails (e.g.
# https://pantrybutler.example.com). When set, email links point here instead
# of localhost, so they work from outside your network. If left blank, the
# server falls back to CORS_ORIGIN (http://localhost:3000). Can also be set
# from the admin config page (Auth & Mail Config → Public URL).
#APP_URL=

# SMTP — used to deliver verification emails. When SMTP_HOST is empty (default)
# verification links are logged to the server console instead of sent.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=
#SMTP_SECURE=false
